# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-new-random-value
# For LOCAL HTTP development only; omit in production (HTTPS required).
DEV_INSECURE_COOKIES=1
# Optional persistent production rate limiter: redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
